# Shared Compose project so both stacks join the same network
# (must match DataStatisticsService/.env; equals the parent-repo folder name
# so the unified root docker-compose produces identical resources)
COMPOSE_PROJECT_NAME=dataingestorapp

# ASP.NET
ASPNETCORE_ENVIRONMENT=Development

# RabbitMQ — MUST match DataStatisticsService/.env
RABBITMQ_USER=user
RABBITMQ_PASS=password
RABBITMQ_EXCHANGE=weak-app
RABBITMQ_QUEUE=ingested-data-processing-queue
RABBITMQ_QUEUE_KEY=ingested-data.message

# WeakApp HTTP client
WEAKAPP_METERING_ENDPOINT=/meters
WEAKAPP_TIMEOUT_SECONDS=10
WEAKAPP_RETRY_COUNT=3
WEAKAPP_CB_FAILURE_COUNT=5
WEAKAPP_CB_BREAK_DURATION=30
WEAKAPP_API_KEY=supersecret

# Polling (passed to compose; worker currently hardcodes 30s)
POLLING_INTERVAL=30

# Grafana (monitoring stack in same compose)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
